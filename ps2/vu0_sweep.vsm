; VU0 micro: 8 independent SIMD4 constraints, four sequential points each.
; 22 input QW, 8 output QW per group, stride 30, 241/256 DMEM QW.
; 'mass' is mass*pointMassScale; 'bias' is mass*velocityBias
; + impulseScale*old. K is the 6 off-diagonal influence terms.
        .vu
        .align 4
        .global B3Vu0Sweep_CodeStart
        .global B3Vu0Sweep_CodeEnd
B3Vu0Sweep_CodeStart:
        NOP                                  iaddiu VI01,VI00,1
        NOP                                  ilw.x VI04,0(VI00)
        NOP                                  iaddiu VI03,VI00,1
vu0_sweep_loop:
